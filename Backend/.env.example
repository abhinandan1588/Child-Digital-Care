# ---------------------------------------------------------------------------
# Child Digital Care - backend configuration example
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real .env. NEVER reuse these placeholder values outside of
# local development - startup validation rejects them when APP_ENV=production.
# ---------------------------------------------------------------------------

APP_NAME=Child Digital Care API
APP_ENV=development                 # development | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Cryptography ----------------------------------------------------------
# HS256 fallback secret. Used only when JWT_ALGORITHM=HS256.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-for-local-development

# Set JWT_ALGORITHM=RS256 and supply a PEM keypair for staging/production.
# Two ways to provide the keys; inline wins if both are given.
#   1. *_PATH  - a file, for Docker/Kubernetes secret mounts.
#   2. inline  - the PEM text itself, for platforms whose only secret store is
#                an environment variable (Render, Fly, Heroku). Newlines
#                written as literal \n are accepted and repaired.
# Generate a keypair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
JWT_ALGORITHM=HS256                 # HS256 | RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=child-digital-care
JWT_KEY_ID=local-dev-1

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEVICE_ACCESS_TOKEN_EXPIRE_MINUTES=15
DEVICE_REFRESH_TOKEN_EXPIRE_DAYS=180
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1
WS_TICKET_EXPIRE_SECONDS=60

EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PAIRING_INVITATION_EXPIRE_MINUTES=15
PAIRING_MAX_CLAIM_ATTEMPTS=5

# --- Datastores ------------------------------------------------------------
# A connection string copied from a managed provider's dashboard can be pasted
# unedited: a `postgres://` or `postgresql://` scheme is rewritten to the
# asyncpg driver, and `sslmode=` is rewritten to the `ssl=` spelling asyncpg
# expects. Both rewrites happen in app/core/config.py.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/child_digital_care
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0

# --- HTTP surface ----------------------------------------------------------
# Comma-separated allow-list. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_DOCS=true                    # force-disabled in production unless explicitly true
TRUSTED_HOSTS=*

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true           # when Redis is unreachable: allow (true) or reject (false)

# --- Email -----------------------------------------------------------------
EMAIL_PROVIDER=console              # console | smtp | disabled
EMAIL_FROM=noreply@example.test
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Push notifications (FCM) ---------------------------------------------
# Absolute path to a service-account JSON mounted as a secret. Leave empty to
# run with the push integration reported as "not configured".
PUSH_PROVIDER=disabled              # disabled | fcm
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# --- Payments (provider-neutral; no provider selected yet) -----------------
PAYMENT_PROVIDER=disabled           # disabled | generic_hmac
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Object storage (optional) --------------------------------------------
OBJECT_STORAGE_PROVIDER=disabled    # disabled | s3_compatible
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Feature gates ---------------------------------------------------------
# Location is OFF by default. Only enable after disclosure, consent, legal and
# Play-policy review for your deployment. See docs/PRIVACY_AND_RETENTION.md.
FEATURE_LOCATION_ENABLED=false
FEATURE_WEBSITE_RESTRICTIONS_ENABLED=false
FEATURE_GUARDIAN_INVITATIONS_ENABLED=true
FEATURE_WEBSOCKETS_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true

# --- Retention (days) ------------------------------------------------------
RETENTION_DEVICE_EVENTS_DAYS=90
RETENTION_USAGE_SUMMARIES_DAYS=400
RETENTION_LOCATION_SAMPLES_DAYS=30
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_COMMAND_HISTORY_DAYS=180
RETENTION_IDEMPOTENCY_HOURS=24

# --- Commands --------------------------------------------------------------
COMMAND_DEFAULT_TTL_SECONDS=86400
COMMAND_MAX_DELIVERY_ATTEMPTS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console
SENTRY_DSN=
METRICS_ENABLED=true
